{
  "name": "@shader-studio/debug",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@shader-studio/glsl-analysis": "*",
    "@shader-studio/types": "*",
    "@shader-studio/utils": "*",
    "@shader-studio/wgsl-analysis": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./native/*": {
      "types": "./dist/native/*.d.ts",
      "default": "./dist/native/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "native/*": [
        "dist/native/*"
      ]
    }
  }
}
