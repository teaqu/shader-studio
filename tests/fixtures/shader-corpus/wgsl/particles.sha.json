{
  "version": "1.0",
  "storage": {
    "particles": {
      "count": 4096,
      "elementType": "vec4<f32>"
    }
  },
  "passes": {
    "ComputeInit": {
      "type": "compute",
      "path": "init.wgsl",
      "entryPoint": "initParticles",
      "dispatch": {
        "cover": "particles"
      },
      "dispatchOnce": true
    },
    "ComputePresent": {
      "type": "compute",
      "path": "present.wgsl",
      "entryPoint": "renderParticles",
      "resolution": {
        "scale": 0.5
      }
    },
    "Image": {
      "inputs": {
        "iChannel0": {
          "type": "buffer",
          "source": "ComputePresent"
        }
      }
    }
  }
}
