{
  "version": "1.0",
  "storage": {
    "bodies": {
      "count": 256,
      "elementType": "Body"
    }
  },
  "passes": {
    "ComputeInit": {
      "type": "compute",
      "path": "init.wgsl",
      "entryPoint": "initBodies",
      "dispatch": {
        "cover": "bodies"
      },
      "dispatchOnce": true
    },
    "ComputeSim": {
      "type": "compute",
      "path": "sim.wgsl",
      "entryPoint": "simulateBodies",
      "dispatch": {
        "cover": "bodies"
      },
      "dispatchCount": 4
    },
    "ComputePresent": {
      "type": "compute",
      "path": "present.wgsl",
      "entryPoint": "renderBodies",
      "resolution": {
        "scale": 0.5
      },
      "outputLayers": 1
    },
    "Image": {
      "inputs": {
        "iChannel0": {
          "type": "buffer",
          "source": "ComputePresent"
        }
      }
    },
    "common": {
      "path": "common.wgsl"
    }
  }
}
