{
  "version": "1.0",
  "storage": {
    "laneA": {
      "count": 128,
      "stride": 16,
      "elementType": "vec4<f32>"
    },
    "laneB": {
      "count": 128,
      "stride": 16,
      "elementType": "vec4<f32>"
    }
  },
  "passes": {
    "ComputeInit": {
      "type": "compute",
      "path": "passes/substep-init.wgsl",
      "dispatch": {
        "cover": "laneA"
      },
      "dispatchOnce": true,
      "dispatchCount": 1
    },
    "ComputeSubsteps": {
      "type": "compute",
      "path": "passes/substep.wgsl",
      "dispatchCount": 3,
      "outputLayers": 1,
      "dispatchOnce": false,
      "dispatch": {
        "cover": "laneA"
      }
    },
    "Image": {
      "resolution": {
        "aspectRatio": "16:9"
      }
    }
  }
}
