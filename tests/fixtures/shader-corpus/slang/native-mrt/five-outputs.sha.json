        },
        "iChannel1": {
          "type": "buffer",
          "source": "BufferA",
          "output": 1
        },
        "iChannel2": {
          "type": "buffer",
          "source": "BufferA",
          "output": 2
        },
        "iChannel3": {
          "type": "buffer",
          "source": "BufferA",
          "output": 3
        },
        "iChannel4": {
          "type": "buffer",
          "source": "BufferA",
          "output": 4
        }
      }
