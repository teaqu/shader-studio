{
  "name": "shader-studio-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "A VS Code extension for viewing and editing shaders",
  "workspaces": [
    "types",
    "standalone",
    "debug",
    "rendering",
    "utils",
    "extension",
    "ui",
    "shader-explorer",
    "monaco",
    "language-servers/*"
  ],
  "scripts": {
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "knip": "knip --no-config-hints",
    "boundaries": "node .github/scripts/check-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run compile",
    "compile": "npm run build:types && npm run build -w utils && turbo run build copy-to-extension --filter=shader-studio-ui --filter=shader-explorer-ui && turbo run build:code --filter=shader-studio",
    "build:types": "npm run build -w types",
    "build:debug": "npm run build -w debug",
    "build:extension": "npm run build:extension:code",
    "build:ui": "npm run build:types && npm run build -w ui",
    "build:shader-explorer": "npm run build:types && npm run build -w shader-explorer",
    "build:extension:code": "npm run build:code -w extension",
    "compile:extension": "npm run build:extension:code",
    "dev:standalone": "npm run dev -w @shader-studio/standalone",
    "build:standalone": "npm run build:types && npm run build -w @shader-studio/standalone",
    "preview:mobile": "npm run build:standalone && npm run preview -w @shader-studio/standalone -- --host 127.0.0.1 --port 4173",
    "dev:web": "npm run dev:standalone",
    "build:web": "npm run build:standalone",
    "dev:ui": "npm run dev -w ui",
    "dev:shader-explorer": "npm run dev -w shader-explorer",
    "test": "vitest run",
    "clean": "rimraf extension/node_modules extension/dist extension/out ui/node_modules ui/dist types/node_modules types/dist",
    "watch:extension": "npm run watch -w extension",
    "postinstall": "node monaco/scripts/patch-word-highlighter.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "coverage:changes": "node .github/scripts/check-changed-coverage.mjs",
    "coverage:new-files": "node .github/scripts/check-new-file-coverage.mjs",
    "coverage:summary": "node .github/scripts/report-coverage.mjs"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tsconfig/svelte": "^5.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.15",
    "@types/proxyquire": "^1.3.31",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "cpx2": "^7.0.1",
    "eslint": "^9.25.1",
    "eslint-plugin-svelte": "^3.23.1",
    "jsdom": "^26.1.0",
    "knip": "^5.88.1",
    "playwright": "^1.60.0",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.0.1",
    "svelte": "5.56.4",
    "turbo": "^2.10.10",
    "typescript": "^5.8.3",
    "vite": "^6.4.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=9.0.0"
  }
}
