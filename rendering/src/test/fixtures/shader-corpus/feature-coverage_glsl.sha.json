{
  "version": "1.0",
  "script": "./uniforms.ts",
  "passes": {
    "BufferA": {
      "path": "./feature-coverage_glsl.buffer.glsl",
      "inputs": {
        "patternTex": {
          "type": "texture",
          "path": "./assets/orientation-texture.svg",
          "filter": "nearest",
          "wrap": "clamp",
          "vflip": true
        }
      }
    },
    "Image": {
      "inputs": {
        "patternTex": {
          "type": "texture",
          "path": "./assets/orientation-texture.svg",
          "filter": "nearest",
          "wrap": "clamp",
          "vflip": true
        },
        "historyBuffer": {
          "type": "buffer",
          "source": "BufferA"
        }
      },
      "vertex": "./feature-coverage_glsl.vert.glsl"
    },
    "common": {
      "path": "./feature-coverage_glsl.common.glsl"
    }
  }
}
