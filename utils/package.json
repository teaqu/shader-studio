{
  "name": "@shader-studio/utils",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@shader-studio/types": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./source-edits": {
      "types": "./dist/source-edits.d.ts",
      "import": "./dist/esm/source-edits.js",
      "require": "./dist/source-edits.js"
    },
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "source-edits": [
        "dist/source-edits.d.ts"
      ]
    }
  }
}
