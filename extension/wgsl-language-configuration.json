{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "(?:0[xX](?:(?:[0-9a-fA-F]+\\.[0-9a-fA-F]*|\\.[0-9a-fA-F]+|[0-9a-fA-F]+)(?:[pP][+-]?\\d+|#INF))(?:hf|HF|fh|FH|lf|LF|fl|FL|h|H|f|F|l|L)?|0[xX][0-9a-fA-F]+(?:[uU](?:(?:[lL]{1,2})|[zZ])?|(?:(?:[lL]{1,2})|[zZ])[uU]?)?|0[bB][01]+(?:[uU](?:(?:[lL]{1,2})|[zZ])?|(?:(?:[lL]{1,2})|[zZ])[uU]?)?|0[0-7]+(?:[uU](?:(?:[lL]{1,2})|[zZ])?|(?:(?:[lL]{1,2})|[zZ])[uU]?)?|-?(?:(?:(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+|#INF)?|\\d+(?:[eE][+-]?\\d+|#INF))(?:hf|HF|fh|FH|lf|LF|fl|FL|h|H|f|F|l|L)?|(?:0|[1-9]\\d*)(?:[uU](?:(?:[lL]{1,2})|[zZ])?|(?:(?:[lL]{1,2})|[zZ])[uU]?)?))|(?:[A-Za-z_]\\w*)"
}
