  "Coord Pmod": {
    "prefix": "coord-pmod",
    "body": [
      "// Polar modular repetition (radial symmetry)",
      "// Derived from hg_sdf/Mercury library",
      "// WGSL functions cannot mutate their parameters: pass the position by pointer.",
      "fn pmod(p: ptr<function, vec2f>, n: f32) -> f32 {",
      "\tlet angle = 3.14159265 / n;",
      "\tlet a = atan((*p).y, (*p).x) + angle;",
      "\tlet r = length(*p);",
      "\tvar c = floor(a / (2.0 * angle));",
      "\tlet wrapped = a - 2.0 * angle * floor(a / (2.0 * angle)) - angle;",
      "\t*p = vec2f(cos(wrapped), sin(wrapped)) * r;",
      "\tif (abs(c) >= n) { c = abs(c); }",
      "\treturn c;",
      "}"
    ],
    "description": "Polar modular repetition for radial symmetry (hg_sdf/Mercury)",
    "example": [
      "fn pmod(p: ptr<function, vec2f>, n: f32) -> f32 {",
      "    let angle = 3.14159265 / n;",
      "    let a = atan((*p).y, (*p).x) + angle;",
      "    let r = length(*p);",
      "    var c = floor(a / (2.0 * angle));",
      "    let wrapped = a - 2.0 * angle * floor(a / (2.0 * angle)) - angle;",
      "    *p = vec2f(cos(wrapped), sin(wrapped)) * r;",
      "    if (abs(c) >= n) { c = abs(c); }",
      "    return c;",
      "}",
      "",
      "fn mainImage(coord: vec2f) -> vec4f {",
      "    let uv = (2.0 * coord - iResolution.xy) / iResolution.y;",
      "    var p = uv;",
      "    let c = pmod(&p, 6.0);",
      "    let d = p.x - 0.4;",
      "    let hue = c / 6.0;",
      "    let segCol = 0.5 + 0.5 * cos(6.28 * (hue + vec3f(0.0, 0.33, 0.67)));",
      "    let col = mix(vec3f(0.12, 0.12, 0.18), segCol, smoothstep(0.01, 0.0, d));",
      "    return vec4f(col, 1.0);",
      "}"
    ]
  }
