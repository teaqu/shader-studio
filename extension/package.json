{
  "name": "shader-studio",
  "displayName": "Shader Studio",
  "description": "Live GLSL and Slang shader preview, editor, and visual debugger with WebGL and WebGPU pipelines.",
  "version": "1.0.2",
  "publisher": "teaqu",
  "repository": {
    "type": "git",
    "url": "https://github.com/teaqu/shader-studio.git"
  },
  "homepage": "https://github.com/teaqu/shader-studio",
  "bugs": {
    "url": "https://github.com/teaqu/shader-studio/issues"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "shader",
    "glsl",
    "slang",
    "webgl",
    "webgpu",
    "graphics",
    "shadertoy",
    "shader toy",
    "shader viewer",
    "shader editor",
    "openGL",
    "debugging",
    "debugger",
    "inspector",
    "shader debugger",
    "shader inspector"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "shader-studio-icon": {
        "description": "Shader Studio icon",
        "default": {
          "fontPath": "assets/fonts/shader-studio-codicons.woff",
          "fontCharacter": "\\F101"
        }
      },
      "shader-studio-icon-running": {
        "description": "Shader Studio icon (server running)",
        "default": {
          "fontPath": "assets/fonts/shader-studio-codicons.woff",
          "fontCharacter": "\\F102"
        }
      }
    },
    "commands": [
      {
        "command": "shader-studio.view",
        "title": "Shader Studio: New Panel"
      },
      {
        "command": "shader-studio.viewInNewWindow",
        "title": "Shader Studio: New Window"
      },
      {
        "command": "shader-studio.startWebServer",
        "title": "Shader Studio: Start Web Server"
      },
      {
        "command": "shader-studio.stopWebServer",
        "title": "Shader Studio: Stop Web Server"
      },
      {
        "command": "shader-studio.showWebServerMenu",
        "title": "Shader Studio: Web Server Menu"
      },
      {
        "command": "shader-studio.generateConfig",
        "title": "Shader Studio: Generate Config for Shader File"
      },
      {
        "command": "shader-studio.newShader",
        "title": "Shader Studio: New Shader"
      },
      {
        "command": "shader-studio.openShaderExplorer",
        "title": "Shader Studio: Open Shader Explorer",
        "icon": "$(library)"
      },
      {
        "command": "shader-studio.openSettings",
        "title": "Shader Studio: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "shader-studio.transpileGlslToJs",
        "title": "Shader Studio: Transpile GLSL to JavaScript (for debugging)"
      },
      {
        "command": "shader-studio.toggleEditorOverlay",
        "title": "Shader Studio: Toggle Editor Overlay"
      },
      {
        "command": "shader-studio.toggleLock",
        "title": "Shader Studio: Toggle Lock"
      },
      {
        "command": "shader-studio.manualCompile",
        "title": "Shader Studio: Manual Compile"
      },
      {
        "command": "shader-studio.resetLayout",
        "title": "Shader Studio: Reset Panel Layout"
      }
    ],
    "keybindings": [
      {
        "command": "shader-studio.toggleEditorOverlay",
        "key": "ctrl+`",
        "when": "activeWebviewPanelId == 'shader-studio'"
      },
      {
        "command": "shader-studio.toggleLock",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "shader-studio.manualCompile",
        "key": "ctrl+enter",
        "mac": "ctrl+enter"
      }
    ],
    "menus": {},
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shader-studio",
          "title": "Shader Studio",
          "icon": "$(shader-studio-icon)"
        }
      ]
    },
    "views": {
      "shader-studio": [
        {
          "type": "webview",
          "id": "shader-studio.shaderExplorer",
          "name": "EXPLORER"
        }
      ]
    },
    "configuration": {
      "title": "Shader Studio",
      "properties": {
        "shader-studio.webServerPort": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port number for the HTTP web server"
        },
        "shader-studio.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable bundled GLSL and Slang code snippets (requires restart)"
        },
        "shader-studio.navigateOnBufferSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Sync the active buffer between the config panel and VS Code editor (requires shader lock)"
        },
        "shader-studio.lockEditorGroup": {
          "type": "boolean",
          "default": true,
          "description": "Lock the editor group when opening a shader panel, preventing other editors from opening in it."
        },
        "shader-studio.languageServers.glsl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Shader Studio GLSL completion, hover, navigation, diagnostics, symbols, and colors."
        },
        "shader-studio.languageServers.slang.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Shader Studio Slang completion, hover, navigation, diagnostics, symbols, and colors."
        },
        "shader-studio.editor.colorDecorators": {
          "type": "boolean",
          "default": true,
          "description": "Show editable color swatches for literal GLSL vec3/vec4 and Slang float3/float4 colors."
        },
        "shader-studio.languageServers.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Controls Shader Studio language-service logging."
        }
      }
    },
    "configurationDefaults": {
      "[glsl]": {
        "editor.colorDecoratorsActivatedOn": "click",
        "cSpell.words": [
          "GLSL",
          "acosh",
          "asinh",
          "atanh",
          "bvec",
          "dmat",
          "dvec",
          "faceforward",
          "fract",
          "fwidth",
          "inout",
          "inversesqrt",
          "isampler",
          "isinf",
          "isnan",
          "ivec",
          "modf",
          "smoothstep",
          "snorm",
          "texel",
          "trunc",
          "unorm",
          "usampler",
          "uvec"
        ]
      },
      "[slang]": {
        "editor.colorDecoratorsActivatedOn": "click",
        "cSpell.words": [
          "GLSL",
          "WGSL",
          "acosh",
          "asfloat",
          "asinh",
          "asint",
          "asuint",
          "atanh",
          "bitfield",
          "copysign",
          "cospi",
          "countbits",
          "earlydepthstencil",
          "faceforward",
          "fastopt",
          "fdim",
          "firstbithigh",
          "firstbitlow",
          "fmax",
          "fmin",
          "fmod",
          "forcecase",
          "fract",
          "frexp",
          "fwidth",
          "globallycoherent",
          "groupshared",
          "inout",
          "isfinite",
          "isinf",
          "isnan",
          "ldexp",
          "lerp",
          "maximallyReconverges",
          "modf",
          "nextafter",
          "nointerpolation",
          "nonmutating",
          "numthreads",
          "powr",
          "quadDerivatives",
          "rcp",
          "reversebits",
          "rint",
          "rsqrt",
          "sincos",
          "sinpi",
          "smoothstep",
          "snorm",
          "tanpi",
          "texel",
          "trunc",
          "unorm"
        ]
      }
    },
    "languages": [
      {
        "id": "glsl",
        "aliases": [
          "GLSL",
          "OpenGL Shading Language"
        ],
        "extensions": [
          ".glsl",
          ".frag",
          ".vert",
          ".geom",
          ".tesc",
          ".tese",
          ".comp"
        ],
        "configuration": "./glsl-language-configuration.json",
        "priority": "default"
      },
      {
        "id": "slang",
        "aliases": [
          "Slang"
        ],
        "extensions": [
          ".slang"
        ],
        "configuration": "./slang-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "glsl",
        "scopeName": "source.glsl",
        "path": "./syntaxes/glsl.tmLanguage.json"
      },
      {
        "language": "slang",
        "scopeName": "source.slang",
        "path": "./syntaxes/slang.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.sha.json",
        "url": "./schemas/shader-config.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "glsl",
        "path": "./snippets/sdf-2d.code-snippets"
      },
      {
        "language": "glsl",
        "path": "./snippets/sdf-3d.code-snippets"
      },
      {
        "language": "glsl",
        "path": "./snippets/math.code-snippets"
      },
      {
        "language": "glsl",
        "path": "./snippets/coordinates.code-snippets"
      },
      {
        "language": "slang",
        "path": "./snippets/sdf-2d.slang.code-snippets"
      },
      {
        "language": "slang",
        "path": "./snippets/sdf-3d.slang.code-snippets"
      },
      {
        "language": "slang",
        "path": "./snippets/math.slang.code-snippets"
      },
      {
        "language": "slang",
        "path": "./snippets/coordinates.slang.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:ui && npm run build:shader-explorer && npm run build:code",
    "watch": "node esbuild.js --watch",
    "copy-glsl-to-dist": "rimraf dist/node_modules && cpx \"../node_modules/glsl-transpiler/**/*\" dist/node_modules/glsl-transpiler && cpx \"../node_modules/inherits/**/*\" dist/node_modules/inherits && cpx \"../node_modules/through2/**/*\" dist/node_modules/through2 && cpx \"../node_modules/through/**/*\" dist/node_modules/through && cpx \"../node_modules/glsl-tokenizer/**/*\" dist/node_modules/glsl-tokenizer && cpx \"../node_modules/glsl-parser/**/*\" dist/node_modules/glsl-parser && cpx \"../node_modules/xtend/**/*\" dist/node_modules/xtend && cpx \"../node_modules/subscript/**/*\" dist/node_modules/subscript && cpx \"../node_modules/prepr/**/*\" dist/node_modules/prepr && cpx \"../node_modules/pick-by-alias/**/*\" dist/node_modules/pick-by-alias && cpx \"../node_modules/strip-json-comments/**/*\" dist/node_modules/strip-json-comments && cpx \"../node_modules/parenthesis/**/*\" dist/node_modules/parenthesis && cpx \"../node_modules/object-assign/**/*\" dist/node_modules/object-assign && cpx \"../node_modules/jsep/**/*\" dist/node_modules/jsep && cpx \"../node_modules/escaper/**/*\" dist/node_modules/escaper && cpx \"../node_modules/expression-eval/**/*\" dist/node_modules/expression-eval && cpx \"../node_modules/core-util-is/**/*\" dist/node_modules/core-util-is && cpx \"../node_modules/balanced-match/**/*\" dist/node_modules/balanced-match && cpx \"../node_modules/readable-stream/**/*\" dist/node_modules/readable-stream && cpx \"../node_modules/isarray/**/*\" dist/node_modules/isarray && cpx \"../node_modules/string_decoder/**/*\" dist/node_modules/string_decoder && cpx \"../node_modules/process-nextick-args/**/*\" dist/node_modules/process-nextick-args && cpx \"../node_modules/util-deprecate/**/*\" dist/node_modules/util-deprecate",
    "package": "npm run build:ui && npm run build:shader-explorer && node esbuild.js --production && npm run copy-glsl-to-dist",
    "vsce-package": "npm run package && vsce package --no-dependencies",
    "compile-tests": "npm run build:deps && rimraf out && tsc -p ./tsconfig.test.json",
    "watch-tests": "rimraf out && tsc -p . -w --outDir out",
    "build:code": "npm run build:deps && node esbuild.js && tsc -p ./",
    "build:deps": "cd ../types && npm run build && cd ../language-servers/core && npm run build && cd ../glsl-analysis && npm run build && cd ../glsl && npm run build && cd ../slang && npm run build && cd ../../debug && npm run build && cd ../rendering && npm run build && cd ../utils && npm run build",
    "build:force": "npm run package",
    "build": "npm run package",
    "build:ui": "cd ../ui && npm run build && npm run copy-to-extension",
    "build:shader-explorer": "cd ../shader-explorer && npm run build && npm run copy-to-extension",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:e2e:vscode": "npm run compile && npm run test:e2e:vscode:run",
    "test:e2e:vscode:run": "wdio run ./e2e/wdio.conf.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "esbuild": "^0.24.0",
    "sinon": "^21.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "wdio-vscode-service": "^8.0.0",
    "webdriverio": "^9.30.1"
  },
  "dependencies": {
    "@shader-studio/glsl-language-server": "*",
    "@shader-studio/language-server-core": "*",
    "@shader-studio/slang-language-server": "*",
    "@shader-studio/types": "*",
    "@shader-studio/utils": "*",
    "entities": "^6.0.1",
    "esbuild": "^0.24.0",
    "glsl-transpiler": "^3.0.3",
    "ws": "^8.18.3"
  }
}
