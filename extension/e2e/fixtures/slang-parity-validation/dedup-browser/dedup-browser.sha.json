{
  "version": "1.0",
  "passes": {
    "Image": {
      "inputs": {
        "tex0": {
          "type": "texture",
          "path": "./red.svg",
          "filter": "nearest",
          "wrap": "clamp"
        },
        "alias": {
          "type": "texture",
          "path": "./red.svg",
          "filter": "nearest",
          "wrap": "clamp"
        },
