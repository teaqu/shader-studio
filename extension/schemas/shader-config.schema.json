{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shader Studio Configuration",
  "description": "Configuration file for Shader Studio extension (.sha.json)",
  "type": "object",
  "required": ["version", "passes"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Configuration version"
    },
    "script": {
      "type": "string",
      "description": "Path to a JavaScript file that exports a uniforms(ctx) function for custom uniforms"
    },
    "scriptMaxPollingFps": {
      "type": "number",
      "description": "Maximum polling rate for the script uniforms function (in evaluations per second). Default: 30",
      "default": 30,
      "minimum": 1,
      "maximum": 120
    },
    "storage": {
      "$ref": "#/definitions/StorageBuffers"
    },
    "passes": {
      "$ref": "#/definitions/ShaderPasses"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ShaderPasses": {
      "type": "object",
      "description": "Shader passes configuration",
      "required": ["Image"],
      "properties": {
        "Image": {
          "$ref": "#/definitions/ImagePass"
        },
        "common": {
          "$ref": "#/definitions/CommonPass"
        }
      },
      "patternProperties": {
        "^(?!Image$|common$)[a-zA-Z_][a-zA-Z0-9_]*$": {
          "oneOf": [
            { "$ref": "#/definitions/BufferPass" },
            { "$ref": "#/definitions/ComputePass" }
          ]
        }
      },
      "additionalProperties": false
    },
    "ImagePass": {
      "type": "object",
      "description": "Main image pass configuration",
      "properties": {
        "inputs": {
          "$ref": "#/definitions/PassInputs"
        },
        "resolution": {
          "$ref": "#/definitions/ImageResolution"
        },
        "geometry": {
          "$ref": "#/definitions/GeometryConfig"
        },
        "blend": {
          "$ref": "#/definitions/BlendMode"
        },
        "clear": {
          "$ref": "#/definitions/ClearColor"
        },
        "depth": {
          "$ref": "#/definitions/DepthSettings"
        },
        "cull": {
          "$ref": "#/definitions/CullMode"
        },
        "vertex": {
          "type": "string",
          "description": "Path to the optional per-pass vertex shader hook source"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "geometry": { "properties": { "type": { "const": "fullscreen" } } } } },
          "then": { "properties": { "depth": false, "cull": false } }
        }
      ],
      "additionalProperties": false
    },
    "BufferPass": {
      "type": "object",
      "description": "Buffer pass configuration",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the buffer GLSL file (relative, absolute, or @ for workspace root)"
        },
        "inputs": {
          "$ref": "#/definitions/PassInputs"
        },
        "resolution": {
          "$ref": "#/definitions/BufferResolution"
        },
        "geometry": {
          "$ref": "#/definitions/GeometryConfig"
        },
        "blend": {
          "$ref": "#/definitions/BlendMode"
        },
        "clear": {
          "$ref": "#/definitions/ClearColor"
        },
        "depth": {
          "$ref": "#/definitions/DepthSettings"
        },
        "cull": {
          "$ref": "#/definitions/CullMode"
        },
        "vertex": {
          "type": "string",
          "description": "Path to the optional per-pass vertex shader hook source"
        },
        "outputFormat": {
          "$ref": "#/definitions/BufferOutputFormat"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "geometry": { "properties": { "type": { "const": "fullscreen" } } } } },
          "then": { "properties": { "depth": false, "cull": false } }
        }
      ],
      "additionalProperties": false
    },
    "CommonPass": {
      "type": "object",
      "description": "Shared source included in renderable passes",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the common GLSL file (relative, absolute, or @ for workspace root)"
        }
      },
      "additionalProperties": false
    },
    "GeometryConfig": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "description": "One oversized triangle covering every pixel (three vertices).",
          "properties": { "type": { "const": "fullscreen" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "description": "A non-indexed draw with no vertex buffers; mainVertex places every vertex.",
          "properties": {
            "type": { "const": "vertices" },
            "vertexCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647,
              "default": 3,
              "description": "Number of vertices drawn; mainVertex runs once per vertex and receives its index. Defaults to 3."
            },
            "topology": {
              "enum": ["triangle-list", "triangle-strip", "line-list", "line-strip", "point-list"],
              "default": "triangle-list",
              "description": "How the drawn vertices are joined into primitives. Lines and points rasterise at 1px."
            },
            "space": {
              "enum": ["world", "clip"],
              "default": "world",
              "description": "world: mainVertex writes object space and the orbit camera projects it, with depth. clip: mainVertex writes the final screen position, (-1,-1) bottom-left to (1,1) top-right, and the camera is ignored."
            },
            "instanceCount": { "$ref": "#/definitions/InstanceCount" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["plane", "cube", "sphere"] },
            "topology": { "$ref": "#/definitions/MeshTopology" },
            "instanceCount": { "$ref": "#/definitions/InstanceCount" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "model" },
            "path": { "type": "string", "minLength": 1 },
            "mesh": { "type": "string" },
            "topology": { "$ref": "#/definitions/MeshTopology" },
            "instanceCount": { "$ref": "#/definitions/InstanceCount" }
          },
          "additionalProperties": false
        }
      ]
    },
    "MeshTopology": {
      "enum": ["triangle-list", "line-list", "point-list"],
      "default": "triangle-list",
      "description": "How the mesh is drawn: its triangles (default), a wireframe of each unique edge (line-list), or each unique vertex as a 1px point (point-list). cull has no effect on lines and points."
    },
    "InstanceCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Number of copies of the geometry drawn in one call; iInstanceIndex tells the shader which copy it is on. Defaults to 1. Not allowed on fullscreen geometry."
    },
    "BlendMode": {
      "type": "string",
      "enum": ["none", "alpha", "premultiplied", "additive"],
      "default": "none",
      "description": "How this pass combines each fragment with what its own draw already wrote this frame (default: none)."
    },
    "ClearColor": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4,
      "default": [0, 0, 0, 1],
      "description": "RGBA colour this pass starts with each frame (default: opaque black)."
    },
    "DepthSettings": {
      "type": "object",
      "description": "Depth state for plane, cube, sphere, model and vertices geometry. Not allowed on fullscreen geometry.",
      "properties": {
        "test": {
          "type": "boolean",
          "description": "Discard fragments that fail the compare. Defaults to true, or false for vertices in clip space."
        },
        "write": {
          "type": "boolean",
          "default": true,
          "description": "Write the depth of fragments that pass. Defaults to true."
        },
        "compare": {
          "enum": ["never", "less", "equal", "less-equal", "greater", "not-equal", "greater-equal", "always"],
          "default": "less",
          "description": "Depth comparison used while test is on. Defaults to less."
        }
      },
      "additionalProperties": false
    },
    "CullMode": {
      "type": "string",
      "enum": ["none", "back", "front"],
      "default": "none",
      "description": "Faces to discard; counter-clockwise triangles are front-facing. Not allowed on fullscreen geometry (default: none)."
    },
    "ComputePass": {
      "type": "object",
      "description": "Slang compute pass configuration",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "compute"
        },
        "path": {
          "type": "string",
          "description": "Path to the compute Slang file (relative, absolute, or @ for workspace root)"
        },
        "inputs": {
          "$ref": "#/definitions/PassInputs"
        },
        "resolution": {
          "$ref": "#/definitions/BufferResolution"
        },
        "outputLayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Number of texture-array layers in the optional compute output"
        },
        "outputFormat": {
          "$ref": "#/definitions/BufferOutputFormat"
        },
        "dispatch": {
          "$ref": "#/definitions/ComputeDispatch"
        },
        "dispatchCount": {
          "description": "Number of times to encode the pass per frame",
          "allOf": [
            {
              "$ref": "#/definitions/DispatchCount"
            }
          ]
        },
        "dispatchOnce": {
          "type": "boolean",
          "description": "Encode only on the first frame after compile or reset"
        },
        "entryPoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Named [shader(\"compute\")] entry point in the compute source"
        }
      },
      "additionalProperties": false
    },
    "ComputeDispatch": {
      "type": "object",
      "description": "Compute dispatch mode",
      "oneOf": [
        {
          "required": ["count"],
          "properties": {
            "count": {
              "$ref": "#/definitions/PositiveInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["x", "y", "z"],
          "properties": {
            "x": {
              "$ref": "#/definitions/PositiveInteger"
            },
            "y": {
              "$ref": "#/definitions/PositiveInteger"
            },
            "z": {
              "$ref": "#/definitions/PositiveInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["cover"],
          "properties": {
            "cover": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "BufferOutputFormat": {
      "type": "string",
      "enum": ["auto", "rgba16float", "rgba32float"],
      "description": "Storage precision for this producer pass (default: auto)"
    },
    "StorageBuffers": {
      "type": "object",
      "description": "Named GPU storage buffer layouts",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/definitions/StorageBuffer"
        }
      },
      "additionalProperties": false
    },
    "StorageBuffer": {
      "type": "object",
      "required": ["count", "elementType"],
      "properties": {
        "count": {
          "description": "Number of elements",
          "allOf": [
            {
              "$ref": "#/definitions/PositiveInteger"
            }
          ]
        },
        "elementType": {
          "type": "string",
          "pattern": "\\S",
          "description": "Slang element type"
        }
      },
      "additionalProperties": false
    },
    "PositiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "DispatchCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "ImageResolution": {
      "type": "object",
      "description": "Image pass resolution override",
      "oneOf": [
        {
          "properties": {
            "scale": {
              "$ref": "#/definitions/PositiveNumber",
              "description": "Render scale multiplier"
            },
            "aspectRatio": {
              "type": "string",
              "enum": ["16:9", "4:3", "1:1", "fill", "auto"],
              "description": "Canvas aspect ratio mode"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["width", "height"],
          "properties": {
            "scale": {
              "$ref": "#/definitions/PositiveNumber",
              "description": "Render scale multiplier"
            },
            "width": {
              "$ref": "#/definitions/PositiveNumber",
              "description": "Base render width in pixels"
            },
            "height": {
              "$ref": "#/definitions/PositiveNumber",
              "description": "Base render height in pixels"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "BufferResolution": {
      "type": "object",
      "description": "Buffer pass resolution override",
      "oneOf": [
        {
          "required": ["width", "height"],
          "properties": {
            "width": {
              "$ref": "#/definitions/PositiveNumber"
            },
            "height": {
              "$ref": "#/definitions/PositiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["scale"],
          "properties": {
            "scale": {
              "$ref": "#/definitions/PositiveNumber",
              "description": "Multiplier relative to the Image pass resolution"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "PassInputs": {
      "type": "object",
      "description": "Input channels for a pass. Keys can be iChannel0-iChannel15 or custom GLSL-valid identifiers.",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/definitions/ConfigInput"
        }
      },
      "additionalProperties": false,
      "maxProperties": 16
    },
    "ConfigInput": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "source"],
          "properties": {
            "type": {
              "const": "buffer"
            },
            "source": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
              "description": "Source buffer name (any valid GLSL identifier)"
            },
            "layer": {
              "type": "integer",
              "minimum": 0,
              "description": "Texture-array layer of a multi-layer compute output"
            },
            "filter": {
              "type": "string",
              "enum": ["linear", "nearest"],
              "description": "Buffer sampling filter (default: linear)"
            },
            "wrap": {
              "type": "string",
              "enum": ["repeat", "clamp"],
              "description": "Buffer addressing mode (default: clamp)"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "texture"
            },
            "path": {
              "type": "string",
              "description": "Path to texture file"
            },
            "filter": {
              "type": "string",
              "enum": ["linear", "nearest", "mipmap"],
              "description": "Texture filtering mode"
            },
            "wrap": {
              "type": "string",
              "enum": ["repeat", "clamp"],
              "description": "Texture wrap mode"
            },
            "vflip": {
              "type": "boolean",
              "description": "Whether to flip texture vertically"
            },
            "grayscale": {
              "type": "boolean",
              "description": "Load texture as single channel (R8) instead of RGBA"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "video"
            },
            "path": {
              "type": "string",
              "description": "Path to video file"
            },
            "filter": {
              "type": "string",
              "enum": ["linear", "nearest", "mipmap"],
              "description": "Video filtering mode"
            },
            "wrap": {
              "type": "string",
              "enum": ["repeat", "clamp"],
              "description": "Video wrap mode"
            },
            "vflip": {
              "type": "boolean",
              "description": "Whether to flip video vertically"
            },
            "muted": {
              "type": "boolean",
              "description": "Whether this channel's audio starts muted (default: false)"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "cubemap"
            },
            "path": {
              "type": "string",
              "description": "Path to cubemap cross-pattern PNG file"
            },
            "filter": {
              "type": "string",
              "enum": ["linear", "nearest", "mipmap"],
              "description": "Cubemap filtering mode"
            },
            "wrap": {
              "type": "string",
              "enum": ["repeat", "clamp"],
              "description": "Cubemap wrap mode"
            },
            "vflip": {
              "type": "boolean",
              "description": "Whether to flip cubemap faces vertically"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "keyboard"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": {
              "const": "audio"
            },
            "path": {
              "type": "string",
              "description": "Path to audio file"
            },
            "startTime": {
              "type": "number",
              "minimum": 0,
              "description": "Loop region start time in seconds"
            },
            "endTime": {
              "type": "number",
              "minimum": 0,
              "description": "Loop region end time in seconds"
            },
            "muted": {
              "type": "boolean",
              "description": "Whether this channel starts muted (default: false)"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
