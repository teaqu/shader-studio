{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "(?:0[xX][0-9a-fA-F]+(?:[uU](?:ll?|LL?)?|(?:ll?|LL?)[uU]?)?|0[bB][01]+(?:[uU](?:ll?|LL?)?|(?:ll?|LL?)[uU]?)?|-?(?:(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?[fFhH]?|\\d+[eE][+-]?\\d+[fFhH]?|\\d+[fFhH]|\\d+(?:[uU](?:ll?|LL?)?|(?:ll?|LL?)[uU]?)?))|(?:[A-Za-z_]\\w*)"
}
