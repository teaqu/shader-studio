{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shader-studio/ui": [
        "../ui/src/index.ts"
      ],
      "@shader-studio/ui/*": [
        "../ui/src/*"
      ],
      "@shader-studio/types": [
        "../types/src/index.ts"
      ],
      "@shader-studio/shader-explorer/*": [
        "../shader-explorer/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts",
    "../ui/src/**/*.d.ts",
    "../shader-explorer/src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
